# Copy this file to keystore.properties and fill in your own values.
# keystore.properties is ignored by git and must never be committed.
#
# For CI, set these repository secrets instead:
#   KEYSTORE_BASE64, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
storeFile=/absolute/path/to/hardwire-release.jks
storePassword=change-me
keyAlias=hardwire
keyPassword=change-me
